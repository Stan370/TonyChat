# Deployment Environment:
NODE_ENV="development"
NEXT_PUBLIC_VERCEL_ENV="${NODE_ENV}"
# Public URL of this deployment (sent to OpenRouter for attribution)
NEXT_PUBLIC_SITE_URL="https://tony-chat-nine.vercel.app"

# NextJS:
NEXT_PUBLIC_BACKEND_URL="localhost:3000"

# ---------------------------------------------------------------------------
# Model providers. Set any you like; none are required.
# Visitors can also paste their own keys in Settings (stored in their browser).
# Keys set here are used for every visitor, so keep them server-side.
# ---------------------------------------------------------------------------

# Free or free-tier (no credit card needed to start)
GOOGLE_GEMINI_API_KEY=          # https://aistudio.google.com/apikey (GEMINI_API_KEY also accepted)
OPENROUTER_API_KEY=             # https://openrouter.ai/settings/keys  (only :free models are used with this key)
GROQ_API_KEY=                   # https://console.groq.com/keys
MISTRAL_API_KEY=                # https://console.mistral.ai/api-keys  (free Experiment plan)
ZHIPU_API_KEY=                  # https://bigmodel.cn  (GLM-4.7-Flash is free)
SILICONFLOW_API_KEY=            # https://cloud.siliconflow.cn  (Qwen3-8B and other small models are free)

# Local models with Ollama (self-hosted TonyChat only), for example http://localhost:11434/v1
OLLAMA_BASE_URL=

# Paid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional endpoint overrides (proxies, gateways, international endpoints)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
OPENAI_PROXY_URL=
OPENAI_ORG_ID=
GOOGLE_GEMINI_BASE_URL=
OPENROUTER_BASE_URL=
GROQ_BASE_URL=
MISTRAL_BASE_URL=
ZHIPU_BASE_URL=                 # https://api.z.ai/api/paas/v4 for international Z.ai accounts
SILICONFLOW_BASE_URL=           # https://api.siliconflow.com/v1 for international accounts

# Not used by the chat yet (see docs/IMPROVEMENT_PLAN.md)
PERPLEXITY_API_KEY=
AZURE_OPENAI_API_KEY=
NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=
NEXT_PUBLIC_AZURE_GPT_35_TURBO_ID=
NEXT_PUBLIC_AZURE_GPT_45_VISION_ID=
NEXT_PUBLIC_AZURE_GPT_45_TURBO_ID=
